repositories:
  - name: bitnami
    url: https://charts.bitnami.com/bitnami
  - name: kong
    url: https://charts.konghq.com
  - name: fairwinds-stable
    url: https://charts.fairwinds.com/stable
  - name: grafana
    url: https://grafana.github.io/helm-charts
  - name: open-telemetry
    url: https://open-telemetry.github.io/opentelemetry-helm-charts

environments:
  local:
  production:

---

releases:
  - name: kong
    chart: kong/ingress
    version: "0.21.0"
    namespace: kong
    createNamespace: true
    installed: {{ eq .Environment.Name "local" }}
    values:
      - values/kong.yaml

  - name: goldilocks
    chart: fairwinds-stable/goldilocks
    version: "10.3.0"
    namespace: goldilocks
    createNamespace: true
    installed: {{ eq .Environment.Name "local" }}
    values:
      - values/goldilocks.yaml

  - name: mimir
    chart: grafana/mimir-distributed
    namespace: observability
    createNamespace: true
    installed: {{ eq .Environment.Name "local" }}
    values:
      - values/mimir.yaml

  - name: tempo
    chart: grafana/tempo
    namespace: observability
    createNamespace: true
    installed: {{ eq .Environment.Name "local" }}
    values:
      - values/tempo.yaml

  - name: loki
    chart: grafana/loki
    namespace: observability
    createNamespace: true
    installed: {{ eq .Environment.Name "local" }}
    values:
      - values/loki.yaml

  - name: otel-collector
    chart: open-telemetry/opentelemetry-collector
    namespace: observability
    createNamespace: true
    installed: {{ eq .Environment.Name "local" }}
    needs:
      - observability/mimir
      - observability/tempo
      - observability/loki
    values:
      - values/otel-collector.yaml

  - name: otel-collector-node
    chart: open-telemetry/opentelemetry-collector
    namespace: observability
    createNamespace: true
    installed: {{ eq .Environment.Name "local" }}
    needs:
      - observability/mimir
    values:
      - values/otel-collector-node.yaml

  - name: grafana
    chart: grafana/grafana
    namespace: observability
    createNamespace: true
    installed: {{ eq .Environment.Name "local" }}
    needs:
      - observability/mimir
      - observability/tempo
      - observability/loki
    values:
      - values/grafana.yaml

  - name: movie-rating
    chart: ../movie-rating
    namespace: movie-rating
    createNamespace: true
    hooks:
      - events: ["postsync"]
        command: kubectl
        args:
          - label
          - namespace
          - movie-rating
          - "goldilocks.fairwinds.com/enabled=true"
          - --overwrite
    {{- if eq .Environment.Name "local" }}
    needs:
      - kong/kong
      - goldilocks/goldilocks
      - observability/otel-collector
    {{- end }}
